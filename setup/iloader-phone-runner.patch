--- /dev/null
+++ b/src-tauri/src/tapilot.rs
@@ -0,0 +1,345 @@
+//! Tapilot one-button setup (added by the Phone Runner Probe patch).
+//!
+//! Steps, each reported to the frontend as an operation step:
+//! 1. devmode  - show the Developer Mode switch in Settings (AMFI, best effort)
+//! 2. download - SideStore, Tapilot and the repackaged WebDriverAgent
+//! 3. sidestore - install SideStore and place its pairing file
+//! 4. tapilot  - install Tapilot and place its pairing file
+//! 5. wda      - install WebDriverAgent (test bundle under Frameworks/)
+//! 6. files    - copy the two IPAs into Tapilot's Documents so the user can
+//!    add them to SideStore from the Files app (SideStore refreshes them later)
+//! 7. trust    - trust the developer profiles on the device (AMFI, best effort)
+
+use std::path::PathBuf;
+
+use idevice::{
+    IdeviceService, amfi::AmfiClient, house_arrest::HouseArrestClient,
+    installation_proxy::InstallationProxyClient, misagent::MisagentClient,
+};
+use tauri::{AppHandle, Manager, State, Window};
+
+use crate::{
+    device::{DeviceInfoMutex, DeviceInfoWithPairing, get_provider},
+    error::AppError,
+    operation::Operation,
+    pairing::{get_sidestore_info, place_file},
+    sideload::{SideloaderMutex, download, sideload},
+};
+
+const SIDESTORE_URL: &str =
+    "https://github.com/SideStore/SideStore/releases/latest/download/SideStore.ipa";
+const TAPILOT_URL: &str =
+    "https://github.com/ichekemon-prog/iphoneGAME-/releases/latest/download/Tapilot.ipa";
+const WDA_URL: &str = "https://github.com/ichekemon-prog/iphoneGAME-/releases/latest/download/WebDriverAgent-tapilot.ipa";
+
+/// Where Tapilot looks for a pairing file delivered from the PC.
+const TAPILOT_PAIRING_PATH: &str = "phone-runner-pairing.plist";
+/// Folder inside Tapilot's Documents (visible in the Files app).
+const IPA_FOLDER: &str = "SideStore用";
+
+fn current_device(state: &State<'_, DeviceInfoMutex>) -> Result<DeviceInfoWithPairing, AppError> {
+    let guard = state.lock().unwrap();
+    guard.clone().ok_or(AppError::NoDeviceSelected)
+}
+
+fn coms(context: &str, e: impl ToString) -> AppError {
+    AppError::DeviceComsWithMessage(context.into(), e.to_string())
+}
+
+/// Shows the Developer Mode switch (Settings > Privacy & Security) when it is off.
+/// Returns Some(true) if already on, Some(false) if revealed, None if unknown.
+async fn prepare_developer_mode(device: &DeviceInfoWithPairing) -> Option<bool> {
+    let provider = get_provider(&device.info).await.ok()?;
+    let mut amfi = match AmfiClient::connect(&provider).await {
+        Ok(a) => a,
+        Err(e) => {
+            tracing::warn!("AMFI connect failed: {e}");
+            return None;
+        }
+    };
+    match amfi.get_developer_mode_status().await {
+        Ok(true) => Some(true),
+        Ok(false) => {
+            if let Err(e) = amfi.reveal_developer_mode_option_in_ui().await {
+                tracing::warn!("Failed to reveal Developer Mode option: {e}");
+            }
+            Some(false)
+        }
+        Err(e) => {
+            tracing::warn!("Developer Mode status unknown: {e}");
+            None
+        }
+    }
+}
+
+/// Finds an installed user app by display name, or by bundle id prefix.
+async fn find_app(
+    device: &DeviceInfoWithPairing,
+    names: &[&str],
+    id_prefix: &str,
+) -> Result<Option<String>, AppError> {
+    let provider = get_provider(&device.info).await?;
+    let mut proxy = InstallationProxyClient::connect(&provider)
+        .await
+        .map_err(|e| coms("Failed to connect to installation proxy", e))?;
+    let apps = proxy
+        .get_apps(Some("User"), None)
+        .await
+        .map_err(|e| coms("Failed to get installed apps", e))?;
+    for (bundle_id, app) in apps {
+        let name = app
+            .as_dictionary()
+            .and_then(|d| d.get("CFBundleDisplayName"))
+            .and_then(|v| v.as_string())
+            .unwrap_or("");
+        if names.contains(&name) || bundle_id.starts_with(id_prefix) {
+            return Ok(Some(bundle_id));
+        }
+    }
+    Ok(None)
+}
+
+/// Copies a local file into an app's Documents folder over AFC.
+async fn copy_to_documents(
+    device: &DeviceInfoWithPairing,
+    bundle_id: &str,
+    folder: &str,
+    file: &PathBuf,
+    name: &str,
+) -> Result<(), AppError> {
+    let data = tokio::fs::read(file)
+        .await
+        .map_err(|e| AppError::Filesystem("Failed to read IPA".into(), e.to_string()))?;
+    let provider = get_provider(&device.info).await?;
+    let house_arrest = HouseArrestClient::connect(&provider)
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to connect to house arrest".into(), e.to_string()))?;
+    let mut afc = house_arrest
+        .vend_documents(bundle_id.to_string())
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to vend documents".into(), e.to_string()))?;
+    afc.mk_dir(format!("/Documents/{folder}"))
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to create folder".into(), e.to_string()))?;
+    let mut handle = afc
+        .open(
+            format!("/Documents/{folder}/{name}"),
+            idevice::afc::opcode::AfcFopenMode::Wr,
+        )
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to open file on device".into(), e.to_string()))?;
+    handle
+        .write_entire(&data)
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to write file".into(), e.to_string()))?;
+    handle
+        .close()
+        .await
+        .map_err(|e| AppError::HouseArrest("Failed to close file".into(), e.to_string()))?;
+    Ok(())
+}
+
+/// Reads the UUID of a provisioning profile (CMS-wrapped plist).
+fn profile_uuid(data: &[u8]) -> Option<String> {
+    let start = data.windows(5).position(|w| w == b"<?xml")?;
+    let end_tag = b"</plist>";
+    let end = data[start..]
+        .windows(end_tag.len())
+        .position(|w| w == end_tag)?
+        + start
+        + end_tag.len();
+    let value = plist::Value::from_reader_xml(&data[start..end]).ok()?;
+    value
+        .as_dictionary()?
+        .get("UUID")?
+        .as_string()
+        .map(str::to_owned)
+}
+
+/// Marks the installed developer profiles as trusted, like tapping "Trust" in
+/// Settings > General > VPN & Device Management. Best effort.
+async fn trust_profiles(device: &DeviceInfoWithPairing) -> usize {
+    let Ok(provider) = get_provider(&device.info).await else {
+        return 0;
+    };
+    let profiles = match MisagentClient::connect(&provider).await {
+        Ok(mut m) => m.copy_all().await.unwrap_or_default(),
+        Err(e) => {
+            tracing::warn!("misagent connect failed: {e}");
+            return 0;
+        }
+    };
+    let Ok(mut amfi) = AmfiClient::connect(&provider).await else {
+        return 0;
+    };
+    let mut trusted = 0;
+    for uuid in profiles.iter().filter_map(|p| profile_uuid(p)) {
+        match amfi.trust_app_signer(uuid.clone()).await {
+            Ok(true) => trusted += 1,
+            Ok(false) => tracing::info!("Profile {uuid} not trusted by AMFI"),
+            Err(e) => tracing::warn!("Trusting profile {uuid} failed: {e}"),
+        }
+    }
+    trusted
+}
+
+async fn fetch(
+    handle: &AppHandle,
+    local: Option<String>,
+    url: &str,
+    file_name: &str,
+) -> Result<PathBuf, AppError> {
+    if let Some(path) = local.filter(|p| !p.is_empty()) {
+        return Ok(PathBuf::from(path));
+    }
+    let dest = handle
+        .path()
+        .temp_dir()
+        .map_err(|e| AppError::Filesystem("Failed to get temp dir".into(), e.to_string()))?
+        .join(file_name);
+    download(url, &dest)
+        .await
+        .map_err(|e| AppError::Download(format!("{file_name}: {e}")))?;
+    Ok(dest)
+}
+
+#[tauri::command]
+pub async fn tapilot_setup_operation(
+    handle: AppHandle,
+    window: Window,
+    device_state: State<'_, DeviceInfoMutex>,
+    sideloader_state: State<'_, SideloaderMutex>,
+    tapilot_path: Option<String>,
+    wda_path: Option<String>,
+) -> Result<(), AppError> {
+    let op = Operation::new("tapilot_setup".to_string(), &window);
+    let device = match current_device(&device_state) {
+        Ok(d) => d,
+        Err(e) => return op.fail("devmode", e),
+    };
+
+    op.start("devmode")?;
+    let devmode = prepare_developer_mode(&device).await;
+    tracing::info!("Developer Mode before setup: {devmode:?}");
+
+    op.move_on("devmode", "download")?;
+    let sidestore_ipa = op.fail_if_err(
+        "download",
+        fetch(&handle, None, SIDESTORE_URL, "SideStore.ipa").await,
+    )?;
+    let tapilot_ipa = op.fail_if_err(
+        "download",
+        fetch(&handle, tapilot_path, TAPILOT_URL, "Tapilot.ipa").await,
+    )?;
+    let wda_ipa = op.fail_if_err(
+        "download",
+        fetch(&handle, wda_path, WDA_URL, "WebDriverAgent-tapilot.ipa").await,
+    )?;
+
+    op.move_on("download", "sidestore")?;
+    op.fail_if_err(
+        "sidestore",
+        sideload(
+            device_state.clone(),
+            sideloader_state.clone(),
+            sidestore_ipa.to_string_lossy().to_string(),
+        )
+        .await,
+    )?;
+    match op.fail_if_err("sidestore", get_sidestore_info(&device.info, false).await)? {
+        Some(info) => {
+            let provider = op.fail_if_err("sidestore", get_provider(&device.info).await)?;
+            op.fail_if_err(
+                "sidestore",
+                place_file(device.pairing.clone(), &provider, info.bundle_id, info.path).await,
+            )?;
+        }
+        None => {
+            return op.fail(
+                "sidestore",
+                AppError::HouseArrest(
+                    "SideStore's not found".into(),
+                    "The device did not report SideStore's bundle ID as installed".into(),
+                ),
+            );
+        }
+    }
+
+    op.move_on("sidestore", "tapilot")?;
+    op.fail_if_err(
+        "tapilot",
+        sideload(
+            device_state.clone(),
+            sideloader_state.clone(),
+            tapilot_ipa.to_string_lossy().to_string(),
+        )
+        .await,
+    )?;
+    let tapilot_id = match op.fail_if_err(
+        "tapilot",
+        find_app(
+            &device,
+            &["Tapilot", "Phone Runner Probe", "PhoneRunnerProbe"],
+            "org.local.PhoneRunnerProbe",
+        )
+        .await,
+    )? {
+        Some(id) => id,
+        None => {
+            return op.fail(
+                "tapilot",
+                AppError::HouseArrest(
+                    "Tapilot's not found".into(),
+                    "The device did not report Tapilot as installed".into(),
+                ),
+            );
+        }
+    };
+    {
+        let provider = op.fail_if_err("tapilot", get_provider(&device.info).await)?;
+        op.fail_if_err(
+            "tapilot",
+            place_file(
+                device.pairing.clone(),
+                &provider,
+                tapilot_id.clone(),
+                TAPILOT_PAIRING_PATH.to_string(),
+            )
+            .await,
+        )?;
+    }
+
+    op.move_on("tapilot", "wda")?;
+    op.fail_if_err(
+        "wda",
+        sideload(
+            device_state.clone(),
+            sideloader_state.clone(),
+            wda_ipa.to_string_lossy().to_string(),
+        )
+        .await,
+    )?;
+
+    op.move_on("wda", "files")?;
+    op.fail_if_err(
+        "files",
+        copy_to_documents(&device, &tapilot_id, IPA_FOLDER, &tapilot_ipa, "Tapilot.ipa").await,
+    )?;
+    op.fail_if_err(
+        "files",
+        copy_to_documents(
+            &device,
+            &tapilot_id,
+            IPA_FOLDER,
+            &wda_ipa,
+            "WebDriverAgent-tapilot.ipa",
+        )
+        .await,
+    )?;
+
+    op.move_on("files", "trust")?;
+    let trusted = trust_profiles(&device).await;
+    tracing::info!("Trusted {trusted} developer profile(s)");
+    op.complete("trust")?;
+    Ok(())
+}
