+/// Phone Runner Probe: every human-readable string stored in an
+/// NSKeyedArchive (skips class names and `$null`).
+fn archive_strings(aux: &AuxValue) -> String {
+    let AuxValue::Array(bytes) = aux else {
+        return String::new();
+    };
+    let Ok(Value::Dictionary(root)) = Value::from_reader(std::io::Cursor::new(bytes)) else {
+        return String::new();
+    };
+    let Some(Value::Array(objects)) = root.get("$objects") else {
+        return String::new();
+    };
+    let skip = |s: &str| s == "$null" || s.starts_with("NS") && !s.contains(' ');
+    let parts: Vec<&str> = objects
+        .iter()
+        .filter_map(|o| o.as_string())
+        .filter(|s| !skip(s))
+        .collect();
+    if parts.is_empty() {
+        String::new()
+    } else {
+        format!(" [{}]", parts.join(" | "))
+    }
+}
