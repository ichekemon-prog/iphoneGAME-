+/// Establishes the three DTX connections over a caller-supplied RSD tunnel
+/// (for example one created from a Remote Pairing record). There is no
+/// lockdown fallback because the caller may have no lockdown provider.
+async fn connect_testmanagerd_over_rsd(
+    mut handle: crate::tcp::handle::AdapterHandle,
+    handshake: &RsdHandshake,
+) -> Result<TestManagerConnections, IdeviceError> {
+    let dvt = rsd_connect(
+        &mut handle,
+        handshake,
+        "com.apple.instruments.dtservicehub",
+        "dtservicehub",
+        true,
+    )
+    .await?;
+    let ctrl = rsd_connect(
+        &mut handle,
+        handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "testmanagerd-ctrl",
+        false,
+    )
+    .await?;
+    let main = rsd_connect(
+        &mut handle,
+        handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "testmanagerd-main",
+        false,
+    )
+    .await?;
+    Ok(TestManagerConnections {
+        ctrl,
+        main,
+        dvt,
+        rsd_handles: vec![handle],
+    })
+}
